# Copy to `.env` and edit. All of this is optional — the stack runs fully
# offline/free with zero edits (LLM_PROVIDER_CHAIN's last entry, ollama, is
# always reachable with no API key). Fill these in only for the exercises
# that need them.

# --- LLM provider fallback chain (default: gemini,openai,anthropic,ollama) ---
# Tried left to right until one succeeds -- mirrors a common production
# .with_fallbacks() pattern, just N-deep instead of one fallback. A provider
# with no API key set below just fails fast and falls through to the next
# one, so it's safe to leave this at its default with only SOME keys filled
# in -- e.g. only GEMINI_API_KEY set below still works exactly as intended,
# it just means Gemini succeeds on the first try every time instead of
# falling through. Reorder this if you want a different default provider,
# e.g. LLM_PROVIDER_CHAIN=ollama to force fully-local/free with no fallback.
LLM_PROVIDER_CHAIN=gemini,openai,anthropic,ollama
OLLAMA_MODEL=qwen2.5:0.5b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Multi-environment posture (see docs/environments.md for the full story) ---
# One of dev / test / staging / prod. dev is the only one where CORS
# defaults to "*" and auth defaults to off -- leave this at dev for the
# zero-setup local workflow.
ENVIRONMENT=dev

# Leave blank to get the ENVIRONMENT-derived default (see docs/environments.md).
# Comma-separated for more than one allowed origin.
CORS_ALLOWED_ORIGINS=

# Shared API key checked via the X-API-Key header on every non-health/
# metrics endpoint, across all 4 custom services -- required outside dev
# unless REQUIRE_AUTH=false is set explicitly.
API_KEY=
REQUIRE_AUTH=

# llm-gateway only -- requests/minute per client IP, applies in every
# environment (not derived from ENVIRONMENT the way CORS/auth are).
RATE_LIMIT_PER_MINUTE=60

# mlflow's Host-header allowlist (see docs/environments.md) -- leave unset for
# dev's "*" default; set to exact hostnames once mlflow is reachable
# outside your own machine.
MLFLOW_ALLOWED_HOSTS=

# --- Langfuse tracing (optional) ---
# Leave blank to run with tracing as a no-op. To enable: `docker compose up
# langfuse-web langfuse-worker langfuse-db langfuse-clickhouse langfuse-redis
# langfuse-minio langfuse-minio-init`, open http://localhost:3000, create an
# account + project, generate an API keypair, then paste it below and
# restart llm-gateway/agent-service.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Offline build variant, used by scripts/offline-up.sh when container-level
# internet egress is broken (some networks/carriers block outbound TCP from
# Docker Desktop's virtualized container network even though the host and
# `docker pull` both work fine -- see the root README's Quick Start section
# for the full diagnosis). Installs from
# pre-downloaded wheels (_offline_wheels/, fetched on the HOST by
# scripts/offline-up.sh) instead of live pip installs. Not used by the
# normal `docker compose up --build` path -- that still uses Dockerfile.
# syntax=docker/dockerfile:1

FROM python:3.11-slim AS builder

WORKDIR /build

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
COPY _offline_wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt

FROM python:3.11-slim AS runtime

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --shell /usr/sbin/nologin --create-home appuser

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY app ./app

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8003/health', timeout=3).status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003"]
